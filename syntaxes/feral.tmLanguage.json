{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Feral",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#strings_single"
		},
		{
			"include": "#strings_back"
		},
		{
			"include": "#numerics"
		},
		{
			"include": "#functions"
		},
		{
			"include": "#fields"
		},
		{
			"include": "#atoms"
		},
		{
			"include": "#struct_types"
		},
		{
			"include": "#line_comment"
		},
		{
			"include": "#block_comment"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [
				{
					"name": "keyword.function",
					"match": "\\b(fn)\\b"
				},
				{
					"name": "keyword.control",
					"match": "\\b(return|yield|await|wait|if|elif|else|for|in|while|continue|break|or|defer)\\b"
				},
				{
					"name": "entity.name.tag",
					"match": "\\b(closure|ref|unref|const|deconst|raise|enum|struct|irange)\\b"
				},
				{
					"name": "storage.modifier",
					"match": "\\b(let|inline)\\b"
				},
				{
					"name": "constant.language",
					"match": "\\b(true|false|nil|self)\\b"
				}
			]
		},
		"strings": {
			"name": "string.quoted.double.feral",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.feral",
					"match": "\\\\."
				}
			]
		},
		"strings_single": {
			"name": "string.quoted.single.feral",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.feral",
					"match": "\\\\."
				}
			]
		},
		"strings_back": {
			"name": "string.quoted.single.feral",
			"begin": "`",
			"end": "`",
			"patterns": [
				{
					"name": "constant.character.escape.feral",
					"match": "\\\\."
				}
			]
		},
		"numerics": {
			"patterns": [
				{
					"match": "\\b([0-9]+[\\.]*[0-9]*)\\b",
					"captures": {
						"1": {
							"name": "constant.numeric"
						}
					}
				}
			]
		},
		"functions": {
			"patterns": [
				{
					"match": "[\\s\\.]*\\b((?!fn|return|yield|await|wait|if|elif|for|while|defer)[_\\w]+)\\b[\\s]*\\(",
					"captures": {
						"1": {
							"name": "entity.name.function"
						}
					}
				}
			]
		},
		"fields": {
			"patterns": [
				{
					"match": "\\.(\\b[_\\w]+\\b)(?!\\()",
					"captures": {
						"1": {
							"name": "variable.other.property"
						}
					}
				}
			]
		},
		"atoms": {
			"patterns": [
				{
					"match": "(?:^|[\\s\\(]+)(\\.[a-zA-Z0-9_]+)",
					"captures": {
						"1": {
							"name": "constant.language"
						}
					}
				}
			]
		},
		"struct_types": {
			"patterns": [
				{
					"name": "support.class",
					"match": "\\b[a-zA-Z0-9_]+Ty\\b"
				}
			]
		},
		"line_comment": {
			"comment": "Single-line comment",
			"name": "comment.line",
			"begin": "#",
			"end": "$"
		},
		"block_comment": {
			"comment": "Block comment",
			"name": "comment.block",
			"begin": "/\\*",
			"end": "\\*/",
			"patterns": [
				{
					"include": "#block_comment"
				}
			]
		}
	},
	"scopeName": "source.fer"
}